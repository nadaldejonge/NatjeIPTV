<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NatjePlayerDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#E6E8ED</item>
        <item name="android:colorAccent">#E6E8ED</item>
        <item name="android:textColorPrimary">#F2F3F5</item>
        <item name="android:textColorSecondary">#BAC0CB</item>
        <item name="colorControlHighlight">#4A505B</item>
        <item name="android:windowBackground">#1A1D22</item>
    </style>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/natje_launch_background</item>
        <item name="windowSplashScreenBackground">@color/natje_brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/natje_adaptive_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
